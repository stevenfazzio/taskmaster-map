# Keys are read from the environment first (export them in your shell profile).
# Alternatively, copy this file to .env and fill them in here — but exported env
# vars take precedence over anything in a local .env.

# Cohere — stage 02 (task embeddings) and stage 04 (Toponymy keyphrase embeddings).
# A production key is recommended; trial keys throttle hard.
CO_API_KEY=

# Anthropic — stage 04 (Toponymy region naming) and stage 05 (taxonomy extraction).
ANTHROPIC_API_KEY=
